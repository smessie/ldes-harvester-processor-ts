@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfcp: <https://w3id.org/rdf-connect/processors#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

rdfcp:LdesHarvester rdfc:jsImplementationOf rdfc:Processor;
    rdfs:label "LDES Harvester";
    rdfs:comment "Processor that can harvest a specific subset of data from a Linked Data Event Stream (LDES).";
    rdfc:file <./lib/index.js>;
    rdfc:class "LdesHarvester";
    rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
    sh:targetClass rdfcp:LdesHarvester;
    sh:property [
        sh:class rdfc:Writer;
        sh:path rdfcp:output;
        sh:codeIdentifier "writer";
        sh:name "Output channel";
        sh:description "Output channel to which the harvested LDES members are written.";
        sh:maxCount 1;
        sh:minCount 1;
    ], [
        sh:nodeKind sh:IRIOrLiteral;
        sh:codeType xsd:string;
        sh:path rdfcp:url;
        sh:codeIdentifier "url";
        sh:name "LDES URL";
        sh:description "URL of the LDES, or of an LDES view, to harvest from.";
        sh:maxCount 1;
        sh:minCount 1;
    ], [
        sh:datatype xsd:dateTime;
        sh:path rdfcp:start;
        sh:codeIdentifier "start";
        sh:name "Start";
        sh:description "Start of the time window to harvest.";
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:dateTime;
        sh:path rdfcp:end;
        sh:codeIdentifier "end";
        sh:name "End";
        sh:description "End of the time window to harvest.";
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:integer;
        sh:path rdfcp:interval;
        sh:codeIdentifier "interval";
        sh:name "Interval";
        sh:description "Length in milliseconds of the intervals the time window is split into; default is 3600000 (1 hour).";
        sh:defaultValue 3600000;
        sh:minCount 0;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:integer;
        sh:path rdfcp:amountPerInterval;
        sh:codeIdentifier "amountPerInterval";
        sh:name "Members per interval";
        sh:description "Maximum number of members harvested per interval; default is 100.";
        sh:defaultValue 100;
        sh:minCount 0;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:boolean;
        sh:path rdfcp:urlIsView;
        sh:codeIdentifier "urlIsView";
        sh:name "URL is a view";
        sh:description "Whether the URL points to an LDES view instead of the LDES itself; default is false.";
        sh:defaultValue false;
        sh:minCount 0;
        sh:maxCount 1;
    ].
