@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

rdfc:LdesHarvester rdfc:jsImplementationOf rdfc:Processor;
    rdfs:label "LDES Harvester";
    rdfs:comment "Processor that can harvest a specific subset of data from a Linked Data Event Stream (LDES).";
    rdfc:file <./lib/index.js>;
    rdfc:class "LdesHarvester";
    rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
    sh:targetClass rdfc:LdesHarvester;
    sh:property [
        sh:class rdfc:Writer;
        sh:path rdfc:writer;
        sh:codeIdentifier "writer";
        sh:name "Output channel";
        sh:maxCount 1;
        sh:minCount 1;
    ], [
        sh:nodeKind sh:IRIOrLiteral;
        sh:codeType xsd:string;
        sh:path rdfc:url;
        sh:codeIdentifier "url";
        sh:name "LDES URL";
        sh:maxCount 1;
        sh:minCount 1;
    ], [
        sh:datatype xsd:dateTime;
        sh:path rdfc:start;
        sh:codeIdentifier "start";
        sh:name "Start";
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:dateTime;
        sh:path rdfc:end;
        sh:codeIdentifier "end";
        sh:name "End";
        sh:minCount 1;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:integer;
        sh:path rdfc:interval;
        sh:codeIdentifier "interval";
        sh:name "Interval";
        sh:defaultValue 3600000;
        sh:minCount 0;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:integer;
        sh:path rdfc:amountPerInterval;
        sh:codeIdentifier "amountPerInterval";
        sh:name "Members per interval";
        sh:defaultValue 100;
        sh:minCount 0;
        sh:maxCount 1;
    ], [
        sh:datatype xsd:boolean;
        sh:path rdfc:urlIsView;
        sh:codeIdentifier "urlIsView";
        sh:name "URL is a view";
        sh:defaultValue false;
        sh:minCount 0;
        sh:maxCount 1;
    ].
